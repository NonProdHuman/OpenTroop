# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev, docker compose up provides this.
DATABASE_URL=postgresql+psycopg://opentroop:opentroop@localhost:5432/opentroop

# ── Auth (OIDC / JWT) ───────────────────────────────────────────────────────
# Point AUTH_JWKS_URI at your OIDC provider's JWKS endpoint.
#
# Clerk (SaaS):
#   AUTH_JWKS_URI=https://<frontend-api>.clerk.accounts.dev/.well-known/jwks.json
#   AUTH_ISSUER=https://<frontend-api>.clerk.accounts.dev
#   AUTH_AUDIENCE=   # leave blank — Clerk JWTs don't include aud by default
#
# Authentik (self-hosted):
#   AUTH_JWKS_URI=https://<authentik-host>/application/o/<app-slug>/jwks/
#   AUTH_ISSUER=https://<authentik-host>/application/o/<app-slug>/
#   AUTH_AUDIENCE=<client-id>
#
AUTH_JWKS_URI=
AUTH_ISSUER=
AUTH_AUDIENCE=

# ── Tenant routing ──────────────────────────────────────────────────────────
# The base domain used to resolve tenants from subdomains.
# e.g. troop123.opentroop.org → tenant slug "troop123"
# For local dev with X-Tenant-ID header, this value is not used.
APP_DOMAIN=opentroop.org
