# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
#   cp apps/web/.env.local.example apps/web/.env.local
#
# See docs/local-setup.md for the full first-time setup walkthrough.

# ── Clerk auth ──────────────────────────────────────────────────────────────
# From dashboard.clerk.com → your project → API Keys.
# The publishable key is also used by start.sh to verify that the frontend and
# backend point at the same Clerk instance (it decodes the instance host from it).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Backend API ─────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Tenant scope ────────────────────────────────────────────────────────────
# The tenant (troop) UUID this dev frontend talks to. Sent as the X-Tenant-ID
# header on every API call. Leave blank until you've run `provision-tenant`
# (see docs/local-setup.md step 4), then paste the printed Tenant ID here.
# In production this is resolved from the subdomain instead.
NEXT_PUBLIC_TENANT_ID=
