# Copy to .env (git-ignored). All EXPO_PUBLIC_* values are compiled into the app
# bundle at build time — they are not runtime settings. See docs/build-and-release.md
# (§3) for how this affects self-hosting.

# Clerk publishable key for this deployment's auth instance (the SaaS app uses the
# OpenTroop Clerk application; a self-host build uses that org's own key).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Local development: point straight at the FastAPI dev server. When set, the app
# sends X-Tenant-ID headers (ALLOW_TENANT_ID_HEADER=true on dev backends).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Production/SaaS: leave EXPO_PUBLIC_API_URL unset and set the app domain instead.
# The client then talks to https://<tenant-slug>.<domain>/api, which satisfies
# subdomain-only tenant resolution (ALLOW_TENANT_ID_HEADER=false in SaaS prod).
# EXPO_PUBLIC_APP_DOMAIN=opentroop.app
#
# Self-hosting: build your own app with your domain (and your Clerk key above),
# e.g. EXPO_PUBLIC_APP_DOMAIN=troop-42.example.org
