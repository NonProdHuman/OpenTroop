{
  "expo": {
    "name": "OpenTroop",
    "slug": "opentroop",
    "version": "0.1.0",
    "scheme": "opentroop",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.opentroop.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.opentroop.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OpenTroop uses Face ID to unlock the app and protect roster data."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
