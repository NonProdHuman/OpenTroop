{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test:run": {
      "inputs": ["src/**/*.{ts,tsx}", "vitest.config.ts"],
      "outputs": ["coverage/**"]
    },
    "test": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    }
  }
}
