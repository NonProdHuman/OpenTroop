# Backend environment variables — copy to .env and fill in values.
# Never commit .env to source control.

# Database
DATABASE_URL=postgresql+psycopg://opentroop:opentroop@localhost:5432/opentroop

# Clerk auth — must match the Clerk project used by the frontend.
# The JWKS URI and issuer are derived from the frontend publishable key:
#   python3 -c "import base64; k='pk_test_<rest>'; print(base64.b64decode(k.split('_',2)[2]+'==').decode())"
AUTH_ISSUER=https://<your-clerk-instance>.clerk.accounts.dev
AUTH_JWKS_URI=https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json
AUTH_AUDIENCE=

# Token signing secret for invite/claim flow — change in production
APP_SECRET=change-me-in-production

# Domain for subdomain tenant routing
APP_DOMAIN=opentroop.app

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]
