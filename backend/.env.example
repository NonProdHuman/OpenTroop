# Backend environment variables — copy to .env and fill in values.
# Never commit .env to source control.

# Database
DATABASE_URL=postgresql+psycopg://opentroop:opentroop@localhost:5432/opentroop

# Platform Administration (BYPASSRLS)
# Set to a role with BYPASSRLS privileges. For local dev/self-hosted, you can use the same URL as above.
DATABASE_URL_ADMIN=postgresql+psycopg://opentroop:opentroop@localhost:5432/opentroop

# Migration Role (BYPASSRLS)
# Used for Alembic migrations.
DATABASE_URL_MIGRATE=postgresql+psycopg://opentroop:opentroop@localhost:5432/opentroop

# Clerk auth — must match the Clerk project used by the frontend.
# The JWKS URI and issuer are derived from the frontend publishable key:
#   python3 -c "import base64; k='pk_test_<rest>'; print(base64.b64decode(k.split('_',2)[2]+'==').decode())"
AUTH_ISSUER=https://<your-clerk-instance>.clerk.accounts.dev
AUTH_JWKS_URI=https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json
AUTH_AUDIENCE=

# Token signing secret for invite/claim flow — change in production
APP_SECRET=change-me-in-production

# Domain for subdomain tenant routing
APP_DOMAIN=opentroop.app

# Honor X-Forwarded-Host for subdomain tenant resolution. Only set to true when a
# trusted proxy (e.g. the Cloudflare Worker) fronts ALL traffic and sets/strips the
# header — it is client-controlled and attacker-chosen otherwise.
TRUST_FORWARDED_HOST=false

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Email delivery — see docs/resend-setup.md.
# "fake" (default) records sends in memory and calls no vendor; use it for local
# dev/tests. Set to "resend" to send real email.
EMAIL_BACKEND=fake
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
