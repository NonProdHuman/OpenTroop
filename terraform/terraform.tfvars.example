# Copy this file to terraform.tfvars and fill in real values.

project_name      = "opentroop"
environment       = "staging"
gcp_project_id    = "your-gcp-project-id"
gcp_region        = "us-central1"
app_domain        = "opentroop.app"
github_repository = "NonProdHuman/OpenTroop"
cloudflare_zone_name = "opentroop.app"

# The first apply needs images that already exist. After that, GitHub Actions can
# push new images into the Artifact Registry repository Terraform creates.
api_image = "us-central1-docker.pkg.dev/your-gcp-project-id/opentroop-staging-containers/opentroop-api:bootstrap"
web_image = "us-central1-docker.pkg.dev/your-gcp-project-id/opentroop-staging-containers/opentroop-web:bootstrap"

clerk_frontend_api     = "your-clerk-frontend-api.clerk.accounts.dev"
clerk_publishable_key  = "pk_live_or_test_..."
clerk_secret_key       = "sk_live_or_test_..."
manage_clerk_jwt_template = true

neon_api_key   = "napi_..."
neon_region_id = "aws-us-east-1"

cloudflare_api_token = "cf_api_token_with_dns_and_workers_permissions"
cloudflare_account_id = "your_cloudflare_account_id"
cloudflare_zone_id   = "your_cloudflare_zone_id"

# Optional hard overrides. Leave unset to use generated Neon URLs.
# database_url         = "postgresql+psycopg://..."
# database_url_admin   = "postgresql+psycopg://..."
# database_url_migrate = "postgresql+psycopg://..."

# Optional, generated when omitted.
# app_secret = "change-me"
# origin_shared_secret = "change-me"

# Edge security (GH-116 / GH-117) — see README "Edge security rollout".
# cloudflare_waf_enabled        = true   # requires Pro plan
# cloudflare_rate_limit_enabled = true   # plan limits apply
# cf_access_enabled        = true
# cf_access_team_domain    = "yourteam"  # yourteam.cloudflareaccess.com
# cf_access_allowed_emails = ["you@example.com"]
